<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <TextView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" android:id="@+id/main_background"
            android:background="@drawable/background_main"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <TextView
                android:layout_width="412dp"
                android:layout_height="68dp" android:id="@+id/fadeBar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@color/light_orange"
                app:layout_constraintEnd_toEndOf="parent"/>
        <Button
                android:gravity="center"
                android:text="Home"
                android:textColor="@color/white"
                android:drawableTop="@drawable/ic_home_black_24dp"
                android:layout_width="83dp"
                android:layout_height="45dp" android:id="@+id/left"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/background_time_small"
                app:iconPadding="0dp" app:iconGravity="textStart" android:layout_marginBottom="12dp"
                app:layout_constraintStart_toStartOf="@+id/fadeBar" android:layout_marginStart="24dp"/>
        <Button
                android:gravity="center"
                android:text="Data"
                android:textColor="@color/white"
                android:layout_width="83dp"
                android:layout_height="45dp" android:id="@+id/right"
                app:layout_constraintBottom_toBottomOf="parent"
                android:drawableTop="@drawable/ic_notifications_black_24dp"
                android:background="@drawable/background_time_small"
                app:iconGravity="textStart" android:layout_marginBottom="12dp"
                app:layout_constraintStart_toEndOf="@+id/button19" android:layout_marginStart="28dp"/>
        <Button
                android:gravity="center"
                android:text="Sport"
                android:textColor="@color/white"
                android:drawableTop="@drawable/ic_dashboard_black_24dp"
                android:layout_width="137dp"
                android:layout_height="49dp" android:id="@+id/button19"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/background_time_small"
                android:textSize="19dp"
                app:iconSize="24dp" app:iconGravity="top" android:layout_marginBottom="12dp"
                app:layout_constraintStart_toEndOf="@+id/left" android:layout_marginStart="28dp"/>
        <Button
                android:paddingRight="0dp"
                android:text="SINGLE"
                android:textSize="20dp"
                android:drawableLeft="@drawable/run"
                android:drawablePadding="0dp"
                android:textColor="@color/white"
                android:background="@drawable/background_time"
                android:layout_width="141dp"
                android:layout_height="139dp" android:id="@+id/singleBtn"
                app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="52dp"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="180dp"/>
        <Button
                android:text="Match"
                android:drawableRight="@drawable/match"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:background="@drawable/background_time"
                android:layout_width="145dp"
                android:layout_height="185dp" android:id="@+id/match"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="180dp"
                app:layout_constraintStart_toEndOf="@+id/singleBtn" android:layout_marginStart="25dp"/>
        <Button
                android:text=" Record"
                android:textSize="20dp"
                android:elevation="10dp"
                android:drawableLeft="@drawable/record"
                android:background="@drawable/background_time"
                android:textColor="@color/white"
                android:layout_width="142dp"
                android:layout_height="190dp" android:id="@+id/recordBtn"
                app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="52dp"
                app:layout_constraintTop_toBottomOf="@+id/singleBtn" android:layout_marginTop="15dp"/>
        <Button
                android:text="Progress"
                android:drawableRight="@drawable/moneys"
                android:textSize="18dp"
                android:background="@drawable/background_time"
                android:textColor="@color/white"
                android:layout_width="141dp"
                android:layout_height="139dp" android:id="@+id/btnProgress"
                app:layout_constraintTop_toBottomOf="@+id/match" app:layout_constraintStart_toEndOf="@+id/recordBtn"
                android:layout_marginStart="25dp" android:layout_marginTop="15dp"/>
        <TextView
                android:text="Spin"
                android:textColor="@color/white"
                android:textSize="65dp"
                android:fontFamily="cursive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/textView11"
                android:layout_marginBottom="28dp"
                app:layout_constraintBottom_toTopOf="@+id/singleBtn" app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="152dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>