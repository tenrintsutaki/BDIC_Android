<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="烟民选爹器"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:rotationX="2" android:scaleX="5" android:scaleY="5"
            app:layout_constraintHorizontal_bias="0.498" android:layout_marginBottom="376dp"
            android:background="#FFFFFF"/>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" android:rotationX="2" android:scaleX="5" android:scaleY="5"
            app:layout_constraintHorizontal_bias="0.498" app:layout_constraintVertical_bias="0.521"
            android:id="@+id/textView"/>
    <Button
            android:text="点击选爹"
            android:layout_width="245dp"
            android:layout_height="83dp" android:id="@+id/button"
            app:icon="@android:drawable/ic_dialog_email"
            app:layout_constraintBottom_toBottomOf="parent" android:layout_marginBottom="195dp"
            android:layout_marginTop="62dp"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            app:layout_constraintVertical_bias="1.0"
            app:backgroundTint="@color/purple_500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginLeft="77dp"
            android:layout_marginStart="77dp" app:layout_constraintHorizontal_bias="0.0" android:textSize="34sp"/>

</androidx.constraintlayout.widget.ConstraintLayout>