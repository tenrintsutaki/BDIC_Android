<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <TextView
            android:text="Login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView3"
            android:textSize="30dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="40dp"
            android:layout_marginTop="87dp" app:layout_constraintTop_toBottomOf="@+id/imageView2"/>
    <EditText
            android:layout_width="340dp"
            android:layout_height="53dp"
            android:inputType="textPersonName"
            android:hint="User Name"
            android:ems="10"
            android:id="@+id/login_account"
            android:background="@drawable/background_input"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="43dp"
            android:layout_marginTop="32dp" app:layout_constraintTop_toBottomOf="@+id/textView3"/>
    <EditText
            android:layout_width="343dp"
            android:layout_height="56dp"
            android:inputType="textPassword"
            android:hint="Password"
            android:ems="10"
            android:id="@+id/login_password"
            android:background="@drawable/background_input"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="43dp"
            android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@+id/login_account"/>
    <Button
            android:text="Confirm"
            android:background="@drawable/background_time"
            android:layout_width="344dp"
            android:layout_height="37dp" android:id="@+id/login_confirm"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="43dp"
            android:layout_marginTop="49dp" app:layout_constraintTop_toBottomOf="@+id/login_password"/>
    <Button
            android:text="Register"
            android:background="@drawable/background_time"
            android:layout_width="104dp"
            android:layout_height="35dp" android:id="@+id/back_to_register"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@+id/login_confirm" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="160dp"/>
    <ImageView
            android:layout_width="301dp"
            android:layout_height="87dp" app:srcCompat="@drawable/spins" android:id="@+id/imageView2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="52dp" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>