<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <Button
            android:rotation="-90"
            android:background="@drawable/arrow"
            android:layout_width="75dp"
            android:outlineProvider="none"
            android:layout_height="66dp" android:id="@+id/left_arrow"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="340dp" app:layout_constraintEnd_toStartOf="@+id/right_arrow"
            android:layout_marginEnd="320dp"/>
    <Button
            android:rotation="90"
            android:outlineProvider="none"
            android:background="@drawable/arrow"
            android:layout_width="75dp"
            android:layout_height="66dp" android:id="@+id/right_arrow"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="332dp" android:layout_marginStart="264dp"
            app:layout_constraintStart_toEndOf="@+id/left_arrow"/>

    <TextView
            android:layout_width="412dp"
            android:layout_height="68dp" android:id="@+id/textView8" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/light_orange"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.0"/>

    <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/line_chart1"
            android:layout_width="412dp"
            android:layout_height="221dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="102dp"/>
    <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/line_chart2"
            android:layout_width="412dp"
            android:layout_height="221dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="45dp">
    </com.github.mikephil.charting.charts.BarChart>

    <TextView
            android:text="Running Speed"
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="140dp"
            android:layout_marginBottom="16dp" app:layout_constraintBottom_toTopOf="@+id/line_chart1"
            android:id="@+id/graphTitle"/>
    <Button
            android:layout_width="386dp"
            android:background="@drawable/background_time_small"
            android:layout_height="53dp" android:id="@+id/button15"
            app:layout_constraintTop_toTopOf="@+id/textView8" app:layout_constraintStart_toStartOf="@+id/textView8"
            android:layout_marginTop="8dp" android:layout_marginStart="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>