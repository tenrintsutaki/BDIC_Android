<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <Button
            android:background="@drawable/background_time"
            android:layout_width="96dp"
            android:drawableLeft="@drawable/ic_arrow_left"
            android:gravity="center"
            android:text="Back"
            android:textColor="@color/black"
            android:layout_height="33dp" android:id="@+id/backButton2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="6dp"/>
    <Button
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/white"
            android:drawableTop="@drawable/ic_home_black_24dp"
            android:layout_width="83dp"
            android:layout_height="45dp" android:id="@+id/buttonHome"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/background_time_small"
            app:iconPadding="0dp" app:iconGravity="textStart" android:layout_marginBottom="12dp"
            android:layout_marginStart="24dp"/>
    <Button
            android:gravity="center"
            android:text="Data"
            android:textColor="@color/white"
            android:layout_width="83dp"
            android:layout_height="45dp" android:id="@+id/button13"
            app:layout_constraintBottom_toBottomOf="parent"
            android:drawableTop="@drawable/ic_notifications_black_24dp"
            android:background="@drawable/background_time_small"
            app:iconGravity="textStart" android:layout_marginBottom="12dp"
            app:layout_constraintStart_toEndOf="@+id/buttonMatch" android:layout_marginStart="28dp"/>
    <Button
            android:gravity="center"
            android:text="Sport"
            android:textColor="@color/white"
            android:drawableTop="@drawable/ic_dashboard_black_24dp"
            android:layout_width="137dp"
            android:layout_height="49dp" android:id="@+id/buttonMatch"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/background_time_small"
            android:textSize="19dp"
            app:iconSize="24dp" app:iconGravity="top" android:layout_marginBottom="12dp"
            app:layout_constraintStart_toEndOf="@+id/buttonHome" android:layout_marginStart="28dp"/>
    <TextView
            android:layout_width="412dp"
            android:layout_height="68dp" android:id="@+id/textView8" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/light_orange"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.0"/>
    <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/line_chart1"
            android:layout_width="412dp"
            android:layout_height="221dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="102dp"/>
    <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/line_chart2"
            android:layout_width="412dp"
            android:layout_height="221dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="45dp">
    </com.github.mikephil.charting.charts.BarChart>
    <Button
            android:rotation="90"
            android:outlineProvider="none"
            android:background="@drawable/arrow"
            android:layout_width="75dp"
            android:layout_height="66dp" android:id="@+id/right_arrow"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/line_chart1" android:layout_marginStart="260dp"
            app:layout_constraintStart_toEndOf="@+id/left_arrow"/>
    <Button
            android:rotation="-90"
            android:outlineProvider="none"
            android:background="@drawable/arrow"
            android:layout_width="75dp"
            android:layout_height="66dp" android:id="@+id/left_arrow"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/line_chart1" app:layout_constraintEnd_toStartOf="@+id/right_arrow"
            android:layout_marginEnd="332dp"/>
    <TextView
            android:text="Running Miles"
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/graphTitle"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="140dp"
            android:layout_marginBottom="16dp" app:layout_constraintBottom_toTopOf="@+id/line_chart1"/>

</androidx.constraintlayout.widget.ConstraintLayout>