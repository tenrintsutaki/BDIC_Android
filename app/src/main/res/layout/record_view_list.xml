<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <Button
            android:text="Details"
            android:background="@drawable/background_time"
            android:layout_width="140dp"
            android:layout_height="34dp" android:id="@+id/button16"
            app:layout_constraintEnd_toEndOf="@+id/run_name" app:layout_constraintTop_toTopOf="@+id/run_name"
            android:layout_marginTop="44dp" android:layout_marginEnd="40dp"/>
    <TextView
            android:text="Record Near Park"
            android:layout_width="411dp"
            android:textSize="15dp"
            android:layout_height="131dp" android:id="@+id/run_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    <TextView
            android:text="0.84"
            android:textStyle="bold"
            android:textSize="40dp"
            android:textColor="@color/orange"
            android:layout_width="93dp"
            android:layout_height="46dp" android:id="@+id/kmNumber"
            app:layout_constraintTop_toTopOf="@+id/run_name"
            android:layout_marginTop="35dp" app:layout_constraintStart_toStartOf="@+id/run_name"
            android:layout_marginStart="35dp"/>
    <TextView
            android:text="KM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView17"
            app:layout_constraintStart_toEndOf="@+id/kmNumber" app:layout_constraintTop_toTopOf="@+id/run_name"
            android:layout_marginTop="50dp"/>
    <TextView
            android:textSize="20dp"
            android:text="234 s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/timeNum"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="35dp"
            app:layout_constraintTop_toBottomOf="@+id/kmNumber" android:layout_marginTop="15dp"/>
    <TextView
            android:text="70 cal"
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/energyNum"
            app:layout_constraintStart_toEndOf="@+id/timeNum" android:layout_marginStart="50dp"
            app:layout_constraintTop_toBottomOf="@+id/kmNumber" android:layout_marginTop="15dp"/>
    <TextView
            android:text="7 km/h"
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/speedNum"
            app:layout_constraintStart_toEndOf="@+id/energyNum" android:layout_marginStart="50dp"
            app:layout_constraintTop_toBottomOf="@+id/button16" android:layout_marginTop="18dp"/>
    <TextView
            android:text="Run"
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView21"
            app:layout_constraintStart_toEndOf="@+id/speedNum" android:layout_marginStart="50dp"
            app:layout_constraintTop_toBottomOf="@+id/button16" android:layout_marginTop="18dp"/>
    <Button
            android:layout_width="fill_parent"
            android:layout_height="20dp" android:id="@+id/button11"
            app:layout_constraintTop_toBottomOf="@+id/run_name" app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>