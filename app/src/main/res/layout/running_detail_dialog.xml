<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <TextView
            android:background="@drawable/background_main"
            android:layout_width="fill_parent"
            android:layout_height="350dp" android:id="@+id/textView14" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/constraintLayout3">

        <TextView
                android:background="@drawable/background_time"
                android:layout_width="357dp"
                android:layout_height="75dp" android:id="@+id/textView23"
                app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="28dp"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="24dp"/>
        <TextView
                android:background="@drawable/background_time"
                android:layout_width="151dp"
                android:layout_height="79dp" android:id="@+id/textView24"
                app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="133dp"
                android:layout_marginTop="33dp" app:layout_constraintTop_toBottomOf="@+id/textView23"/>
        <TextView
                android:text="3.5"
                android:textColor="@color/white"
                android:textSize="60dp"
                android:layout_width="90dp"
                android:layout_height="74dp" android:id="@+id/distance_num"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="156dp" app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="132dp" android:textStyle="bold"/>
        <TextView
                android:text="KM"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/unit_distance"
                app:layout_constraintStart_toEndOf="@+id/distance_num"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="160dp"/>
        <TextView
                android:text="Seconds"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/unit_time"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="32dp" android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/time_num"/>
        <TextView
                android:text="Km/h"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/unit_speed"
                android:layout_marginStart="64dp"
                app:layout_constraintStart_toEndOf="@+id/unit_time" android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/speed_num"/>
        <TextView
                android:text="Calories"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/unit_energe"
                android:layout_marginStart="64dp"
                app:layout_constraintStart_toEndOf="@+id/unit_speed" android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/energy_num"/>
        <TextView
                android:text="30"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/time_num"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="32dp" app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="35dp"/>
        <TextView
                android:text="8"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/speed_num"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="32dp"
                android:layout_marginStart="118dp" app:layout_constraintStart_toEndOf="@+id/time_num"/>
        <TextView
                android:text="30"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/energy_num"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="32dp"
                android:layout_marginStart="104dp" app:layout_constraintStart_toEndOf="@+id/speed_num"/>
        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp" app:srcCompat="@drawable/energy" android:id="@+id/imageView4"
                app:layout_constraintStart_toEndOf="@+id/energy_num"
                app:layout_constraintTop_toTopOf="@+id/textView23" android:layout_marginTop="10dp"/>
        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp" app:srcCompat="@drawable/speed" android:id="@+id/imageView6"
                app:layout_constraintStart_toEndOf="@+id/speed_num"
                app:layout_constraintTop_toTopOf="@+id/textView23" android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"/>
        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp" app:srcCompat="@drawable/timer" android:id="@+id/imageView7"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toTopOf="@+id/textView23"
                app:layout_constraintStart_toEndOf="@+id/time_num"/>
        <ImageButton
                android:outlineProvider="none"
                android:src="@drawable/cancel_circular"
                android:background="@drawable/circular_button_cancel"
                android:layout_width="60dp"
                android:layout_height="60dp" android:id="@+id/stop_run"
                app:layout_constraintEnd_toStartOf="@+id/textView24" android:layout_marginEnd="41dp"
                android:layout_marginTop="47dp" app:layout_constraintTop_toBottomOf="@+id/textView23"/>
        <ImageButton
                android:outlineProvider="none"
                android:background="@drawable/circular_button_confirm"
                android:layout_width="60dp"
                android:src="@drawable/play_circular"
                android:layout_height="60dp" android:id="@+id/start_run"
                android:layout_marginStart="41dp" app:layout_constraintStart_toEndOf="@+id/textView24"
                android:layout_marginTop="47dp" app:layout_constraintTop_toBottomOf="@+id/textView23"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
            android:layout_width="349dp"
            android:layout_height="81dp" android:id="@+id/button17"
            android:background="@drawable/background_time_small"
            app:layout_constraintStart_toStartOf="@+id/textView14" android:layout_marginStart="32dp"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout3" android:layout_marginTop="28dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" tools:layout_editor_absoluteY="0dp"
            tools:layout_editor_absoluteX="0dp">

        <TextView
                android:text="Humidity"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/textView19"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="295dp" android:layout_marginStart="43dp"
                app:layout_constraintStart_toEndOf="@+id/textView27"/>
        <TextView
                android:text="Pressure"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/textView29"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="295dp" android:layout_marginStart="70dp"
                app:layout_constraintStart_toEndOf="@+id/textView19"/>
        <TextView
                android:text="Temperature"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/textView27"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="293dp" app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="45dp"/>
        <TextView
                android:text="25℃"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="82dp"
                android:layout_height="30dp" android:id="@+id/temp_var"
                app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="45dp"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="253dp"/>
        <TextView
                android:text="15%"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="82dp"
                android:layout_height="30dp" android:id="@+id/humidity_var"
                android:layout_marginStart="47dp" app:layout_constraintStart_toEndOf="@+id/temp_var"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="253dp"/>
        <TextView
                android:text="1.05 Bar"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_width="82dp"
                android:layout_height="30dp" android:id="@+id/pressure_var"
                android:layout_marginStart="48dp" app:layout_constraintStart_toEndOf="@+id/humidity_var"
                app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="253dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>